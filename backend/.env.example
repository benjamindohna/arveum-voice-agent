OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Backend für Stellen-/Bewerber-Daten (HTTP). Default: https://voice.arveum.ai
VOICE_BACKEND_URL=https://voice.arveum.ai

# Override der Firmen-Identität (überschreibt /api/company).
# Solange voice.arveum.ai unter /api/company das Profil des Plattform-Anbieters
# liefert statt das des aktuellen Mandanten, hier den gewünschten Namen setzen.
COMPANY_NAME=HiPP Babynahrung
COMPANY_TAGLINE=
